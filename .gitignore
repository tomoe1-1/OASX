# ── OASX 2.x 源码仓库 ──────────────────────────────────────
# 本仓库托管 OASX 2.x 的「构建源码 + 发行目录 + 文档」。
# 可执行产物同时通过 GitHub Release 分发（见 README）。

# ── 本机运行痕迹（不入库）─────────────────────────────────
logs/
*.log
*.tmp
*.bak

# WorkBuddy 工作缓存目录（记忆、草稿、临时脚本、本机备份）
.workbuddy/

# 工作区临时文件（编辑器 / 发布脚本 / 校验草稿）
.publish*.py
.upload*.py
.release_body*.md
*.before-auto-repair
*.before-*
_backup*/

# ── 测试渲染产物 ────────────────────────────────────────────
# 眼睛动画类测试会把渲染结果写成 PNG 落在工作目录（仓库根与 src/），不入库
/closed.png
/half.png
/open.png
/src/eye-*.png
/src/splash-closed.png
/src/splash-half.png
/src/splash-open.png
/src/splash-quarter.png
/src/splash-three-quarter.png
/src/splash-transition.png

# ── Flutter / Dart 构建产物 ────────────────────────────────
# src/ 是完整 Flutter 工程，以下为生成物，不入库
src/.dart_tool/
src/build/
src/.flutter-plugins
src/.flutter-plugins-dependencies
src/.packages
src/.pub-cache/
src/.pub/
src/pubspec_overrides.yaml
src/coverage/
src/**/doc/api/
src/**/ios/Flutter/.last_build_id

# Android 平台构建中间产物
src/android/build/
src/android/.gradle/
src/android/local.properties

# 其他平台
src/ios/Pods/
src/ios/.symlinks/
src/macos/Pods/
src/windows/flutter/ephemeral/

# 手工 / 调试构建目录与 AOT 产物
build_manual/
src/build_manual/
src/lib/**/*.dill
*.dill
app.so
app_det.so
app_abs.so

# Flutter 符号化 / 混淆配置
app.*.symbols
app.*.map.json

# ── 发行包（通过 GitHub Release 分发，不入库，避免重复存储）──
OASX.zip
OASX-*.zip
oasx_*.zip

# ── 系统杂项 ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ── 例外：发行目录的运行必需文件必须入库 ───────────────────
# 本仓库同时是发行目录，exe / dll / so 是分发必需，用 ! 反向豁免
!oasx.exe
!*.dll
!data/app.so
